# Cabinet Médical - Configuration Environment Variables

# API Backend URL
VITE_API_BASE_URL=http://localhost:3000

# Application Settings
VITE_APP_NAME=Cabinet Médical
VITE_APP_VERSION=2.1.0

# Auto-refresh Settings (milliseconds)
VITE_REFRESH_INTERVAL=30000

# WebSocket/SSE Settings
VITE_WEBSOCKET_URL=ws://localhost:3000
VITE_SSE_URL=http://localhost:3000/events

# WhatsApp Business API (if using real API)
# VITE_WHATSAPP_API_KEY=your_api_key_here
# VITE_WHATSAPP_PHONE_NUMBER=+1234567890

# Feature Flags
VITE_ENABLE_BIOLOGICAL_DATA=true
VITE_ENABLE_WHATSAPP_REMINDERS=true
VITE_ENABLE_BILLING_MODULE=true

# Development Settings
VITE_DEBUG_MODE=false
VITE_MOCK_DATA=false
